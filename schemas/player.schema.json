{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "player.schema.json",
  "title": "Ether Wars player snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "chainId", "tournamentAddress", "tournamentId", "snapshot",
    "playerId", "address", "registered", "active", "eliminatedRound", "tableId",
    "seat", "activeColonyCount", "expansionsUsed", "principal",
    "colonies", "roundState", "roundHistory", "neighbors"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "chainId": { "$ref": "definitions.schema.json#/definitions/uintString" },
    "tournamentAddress": { "$ref": "definitions.schema.json#/definitions/address" },
    "tournamentId": { "$ref": "definitions.schema.json#/definitions/uintString" },
    "snapshot": { "$ref": "definitions.schema.json#/definitions/snapshot" },
    "playerId": { "$ref": "definitions.schema.json#/definitions/uintString" },
    "address": { "$ref": "definitions.schema.json#/definitions/address" },
    "registered": { "type": "boolean" },
    "active": { "type": "boolean" },
    "eliminatedRound": { "$ref": "definitions.schema.json#/definitions/nullableUintString" },
    "tableId": { "$ref": "definitions.schema.json#/definitions/uintString" },
    "seat": { "$ref": "definitions.schema.json#/definitions/seat" },
    "activeColonyCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
    "expansionsUsed": { "$ref": "definitions.schema.json#/definitions/uintString" },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "claimed", "claimable"],
      "properties": {
        "amount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "claimed": { "type": "boolean" },
        "claimable": { "$ref": "definitions.schema.json#/definitions/uintString" }
      }
    },
    "colonies": {
      "type": "array",
      "items": { "$ref": "#/definitions/colony" }
    },
    "roundState": { "$ref": "#/definitions/roundState" },
    "roundHistory": {
      "type": "array",
      "description": "Blockchain-derived per-round action and per-colony resource ledger, ordered by roundId ascending.",
      "items": { "$ref": "#/definitions/roundHistoryEntry" }
    },
    "neighbors": {
      "type": "array",
      "items": { "$ref": "#/definitions/neighbor" }
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attack", "defense", "mining", "infrastructure"],
      "properties": {
        "attack": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "defense": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "mining": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "infrastructure": { "$ref": "definitions.schema.json#/definitions/uintString" }
      }
    },
    "resourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gold", "attack", "defense", "mining", "infrastructure"],
      "properties": {
        "gold": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "attack": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "defense": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "mining": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "infrastructure": { "$ref": "definitions.schema.json#/definitions/uintString" }
      }
    },
    "resourceDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gold", "attack", "defense", "mining", "infrastructure"],
      "properties": {
        "gold": { "$ref": "definitions.schema.json#/definitions/intString" },
        "attack": { "$ref": "definitions.schema.json#/definitions/intString" },
        "defense": { "$ref": "definitions.schema.json#/definitions/intString" },
        "mining": { "$ref": "definitions.schema.json#/definitions/intString" },
        "infrastructure": { "$ref": "definitions.schema.json#/definitions/intString" }
      }
    },
    "colony": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "colonyId", "landLordAddress", "active", "createdRound", "availableThisRound",
        "gold", "resources", "settlementState", "stats", "economy", "worldState"
      ],
      "properties": {
        "colonyId": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "landLordAddress": { "$ref": "definitions.schema.json#/definitions/address" },
        "active": { "type": "boolean" },
        "createdRound": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "availableThisRound": { "type": "boolean" },
        "gold": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "resources": { "$ref": "#/definitions/resources" },
        "settlementState": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lastMiningRound", "eligibleMining", "eligibleInfrastructure", "successfulBuildCount", "lastSuccessfulBuildRound"],
          "properties": {
            "lastMiningRound": { "$ref": "definitions.schema.json#/definitions/uintString" },
            "eligibleMining": { "$ref": "definitions.schema.json#/definitions/uintString" },
            "eligibleInfrastructure": { "$ref": "definitions.schema.json#/definitions/uintString" },
            "successfulBuildCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
            "lastSuccessfulBuildRound": { "$ref": "definitions.schema.json#/definitions/uintString" }
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["population", "attackPower", "defensePower", "miningYield", "infrastructureBonusBps", "miningInfrastructureBonusBps"],
          "properties": {
            "population": { "$ref": "definitions.schema.json#/definitions/uintString" },
            "attackPower": { "$ref": "definitions.schema.json#/definitions/uintString" },
            "defensePower": { "$ref": "definitions.schema.json#/definitions/uintString" },
            "miningYield": { "$ref": "definitions.schema.json#/definitions/uintString" },
            "infrastructureBonusBps": { "$ref": "definitions.schema.json#/definitions/uintString" },
            "miningInfrastructureBonusBps": { "$ref": "definitions.schema.json#/definitions/uintString" }
          }
        },
        "economy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseMiningYield", "projectedMiningYield", "projectedNetGoldChange"],
          "properties": {
            "baseMiningYield": { "$ref": "definitions.schema.json#/definitions/uintString" },
            "projectedMiningYield": { "$ref": "definitions.schema.json#/definitions/uintString" },
            "projectedNetGoldChange": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          }
        },
        "worldState": {
          "type": "object",
          "description": "Reference to frontend-originated visual state published separately from blockchain-derived colony data.",
          "additionalProperties": false,
          "required": ["path", "schemaVersion", "stateVersion", "hash"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "schemaVersion": { "type": "integer", "const": 1 },
            "stateVersion": { "$ref": "definitions.schema.json#/definitions/uintString" },
            "hash": {
              "description": "Optional canonical content hash. Null until the hashing format is finalized.",
              "anyOf": [
                { "$ref": "definitions.schema.json#/definitions/bytes32" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetAddress", "wager", "sourceColonyId", "targetColonyId"],
      "properties": {
        "type": { "$ref": "definitions.schema.json#/definitions/actionType" },
        "targetAddress": { "$ref": "definitions.schema.json#/definitions/nullableAddress" },
        "wager": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "sourceColonyId": { "$ref": "definitions.schema.json#/definitions/nullableUintString" },
        "targetColonyId": { "$ref": "definitions.schema.json#/definitions/nullableUintString" }
      }
    },
    "roundState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roundId", "committed", "revealed", "planApplied", "actionStatus", "action"],
      "properties": {
        "roundId": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "committed": { "type": "boolean" },
        "revealed": { "type": "boolean" },
        "planApplied": { "type": "boolean" },
        "actionStatus": { "type": "string", "enum": ["NONE", "COMMITTED", "REVEALED", "APPLIED"] },
        "action": {
          "anyOf": [
            { "$ref": "#/definitions/action" },
            { "type": "null" }
          ]
        }
      }
    },
    "roundHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roundId", "action", "colonies"],
      "properties": {
        "roundId": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "action": {
          "description": "The player's revealed or defaulted action. Attack-specific source, target, and wager data use the shared action shape.",
          "anyOf": [
            { "$ref": "#/definitions/action" },
            { "type": "null" }
          ]
        },
        "colonies": {
          "type": "array",
          "items": { "$ref": "#/definitions/colonyRoundHistory" }
        }
      }
    },
    "colonyRoundHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "colonyId", "allocation", "startingResources", "resourceChanges",
        "endingResources"
      ],
      "properties": {
        "colonyId": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "allocation": { "$ref": "#/definitions/resources" },
        "startingResources": { "$ref": "#/definitions/resourceSnapshot" },
        "resourceChanges": {
          "type": "array",
          "description": "Changes ordered by block number and log index.",
          "items": { "$ref": "#/definitions/resourceChange" }
        },
        "endingResources": { "$ref": "#/definitions/resourceSnapshot" }
      }
    },
    "resourceChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockNumber", "transactionHash", "logIndex", "delta", "resourcesAfter"],
      "properties": {
        "blockNumber": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "transactionHash": { "$ref": "definitions.schema.json#/definitions/bytes32" },
        "logIndex": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "delta": { "$ref": "#/definitions/resourceDelta" },
        "resourcesAfter": { "$ref": "#/definitions/resourceSnapshot" }
      }
    },
    "neighbor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "address", "publicStatePath"],
      "properties": {
        "playerId": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "address": { "$ref": "definitions.schema.json#/definitions/address" },
        "publicStatePath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
