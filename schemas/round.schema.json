{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "round.schema.json",
  "title": "Ether Wars round snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "chainId", "tournamentAddress", "tournamentId", "snapshot",
    "roundId", "status", "timing", "lifecycleBlocks", "players", "tables",
    "randomness", "activity", "settlementTotals", "completion"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "chainId": { "$ref": "definitions.schema.json#/definitions/uintString" },
    "tournamentAddress": { "$ref": "definitions.schema.json#/definitions/address" },
    "tournamentId": { "$ref": "definitions.schema.json#/definitions/uintString" },
    "snapshot": { "$ref": "definitions.schema.json#/definitions/snapshot" },
    "roundId": { "$ref": "definitions.schema.json#/definitions/uintString" },
    "status": {
      "type": "string",
      "enum": ["COMMIT", "REVEAL", "RESOLVING", "FINALIZING", "FINALIZED"]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitStartTimestamp", "commitEndTimestamp", "revealStartTimestamp",
        "revealEndTimestamp", "finalizedTimestamp"
      ],
      "properties": {
        "commitStartTimestamp": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "commitEndTimestamp": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "revealStartTimestamp": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "revealEndTimestamp": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "finalizedTimestamp": { "$ref": "definitions.schema.json#/definitions/nullableUintString" }
      }
    },
    "lifecycleBlocks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedBlockNumber", "startedBlockHash", "finalizedBlockNumber", "finalizedBlockHash"],
      "properties": {
        "startedBlockNumber": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "startedBlockHash": { "$ref": "definitions.schema.json#/definitions/bytes32" },
        "finalizedBlockNumber": { "$ref": "definitions.schema.json#/definitions/nullableUintString" },
        "finalizedBlockHash": {
          "anyOf": [
            { "$ref": "definitions.schema.json#/definitions/bytes32" },
            { "type": "null" }
          ]
        }
      }
    },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startingActiveCount", "endingActiveCount", "committedCount", "revealedCount",
        "defaultDefendCount", "eliminatedCount", "eliminated"
      ],
      "properties": {
        "startingActiveCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "endingActiveCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "committedCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "revealedCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "defaultDefendCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "eliminatedCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "eliminated": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["playerId", "address", "tableId"],
            "properties": {
              "playerId": { "$ref": "definitions.schema.json#/definitions/uintString" },
              "address": { "$ref": "definitions.schema.json#/definitions/address" },
              "tableId": { "$ref": "definitions.schema.json#/definitions/uintString" }
            }
          }
        }
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startingCount", "startingActiveCount", "requiredResolutionCount",
        "resolvedCount", "endingCount", "endingActiveCount"
      ],
      "properties": {
        "startingCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "startingActiveCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "requiredResolutionCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "resolvedCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "endingCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "endingActiveCount": { "$ref": "definitions.schema.json#/definitions/uintString" }
      }
    },
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "requestId", "attempts", "requestedAt", "fulfilled"],
      "properties": {
        "value": { "$ref": "definitions.schema.json#/definitions/nullableUintString" },
        "requestId": { "$ref": "definitions.schema.json#/definitions/nullableUintString" },
        "attempts": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "requestedAt": { "$ref": "definitions.schema.json#/definitions/nullableUintString" },
        "fulfilled": { "type": "boolean" }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflictGroupCount", "successfulBuildPlayerCount",
        "coloniesCreatedCount", "coloniesEliminatedCount", "populationChecksPerformed"
      ],
      "properties": {
        "conflictGroupCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "successfulBuildPlayerCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "coloniesCreatedCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "coloniesEliminatedCount": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "populationChecksPerformed": { "$ref": "definitions.schema.json#/definitions/uintString" }
      }
    },
    "settlementTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflictGoldTransferred", "miningGoldCredited"
      ],
      "properties": {
        "conflictGoldTransferred": { "$ref": "definitions.schema.json#/definitions/uintString" },
        "miningGoldCredited": { "$ref": "definitions.schema.json#/definitions/uintString" }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revealPeriodClosed", "randomnessFulfilled", "battlesResolved",
        "miningSettlementCompleted", "populationChecksCompleted",
        "automaticExpansionsCompleted",
        "tableRebalancingCompleted"
      ],
      "properties": {
        "revealPeriodClosed": { "type": "boolean" },
        "randomnessFulfilled": { "type": "boolean" },
        "battlesResolved": { "type": "boolean" },
        "miningSettlementCompleted": { "type": "boolean" },
        "populationChecksCompleted": { "type": "boolean" },
        "automaticExpansionsCompleted": { "type": "boolean" },
        "tableRebalancingCompleted": { "type": "boolean" }
      }
    }
  }
}
